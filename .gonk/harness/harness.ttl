# The harness of this repository's process: every rule of AGENTS.md as a guide, and every
# place this repository's tools enforce one as a sensor. Committed. Assembled by
# ikigai-gonk-starter's tools/new.py from profiles/harness/<section>.ttl, one fragment per
# AGENTS.md section, exactly as AGENTS.md is assembled, so it describes these profiles and
# nothing else: solo, workers, spec.
#
# Terms: .gonk/harness/vocabulary.ttl. Firings: .gonk/state/harness/firings.log (git-ignored).
# `python3 tools/harness.py check` holds this file to the code and to AGENTS.md;
# `python3 tools/gonk.py harness` loads it into gonk and asks .gonk/queries/harness-*.rq.
# FORMAT: the Turtle subset tools/harness.py reads. No blank nodes.

@prefix harness: <https://ikigai-rs.dev/ns/harness#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ctl:     <urn:iki:harness:starter:control:> .
@prefix guide:   <urn:iki:harness:starter:guide:> .
@prefix test:    <urn:iki:harness:starter:test:> .

# ── claim (profiles/harness/claim.ttl)

guide:claim-before-write a harness:Guide ;
    rdfs:label "no claim, no write" ;
    rdfs:comment "Before changing a file, claim the ledger item the change is for; a change with no item gets one first." ;
    harness:statedIn "AGENTS.md" ; harness:section "1. Claim the item before you write" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:toolCall ; harness:category harness:authoritySafety .

guide:a-claim-is-a-lease a harness:Guide ;
    rdfs:label "a claim is a lease" ;
    rdfs:comment "A claim runs for its lease, and is renewed by claiming the same item again before the lease runs out." ;
    harness:statedIn "AGENTS.md" ; harness:section "1. Claim the item before you write" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:toolCall ; harness:category harness:authoritySafety .

guide:expired-lease-not-free a harness:Guide ;
    rdfs:label "an expired lease is not free" ;
    rdfs:comment "Nobody but its holder may take an item whose lease ran out, except by a takeover, which succeeds only if that holder still has it and the lease has really run out." ;
    harness:statedIn "AGENTS.md" ; harness:section "1. Claim the item before you write" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:toolCall ; harness:category harness:authoritySafety .

guide:stop-when-claim-gone a harness:Guide ;
    rdfs:label "if your claim is gone, stop" ;
    rdfs:comment "When the claim was taken over or released, stop writing, put the work on a branch, say where, and claim something else." ;
    harness:statedIn "AGENTS.md" ; harness:section "1. Claim the item before you write" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:toolCall ; harness:category harness:authoritySafety .

guide:hand-back-when-you-stop a harness:Guide ;
    rdfs:label "hand it back when you stop" ;
    rdfs:comment "Report a finished item with its evidence, or release an unfinished one saying why: either way the item is free again." ;
    harness:statedIn "AGENTS.md" ; harness:section "1. Claim the item before you write" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:toolCall ; harness:category harness:authoritySafety .

guide:a-claim-is-a-fence a harness:Guide ;
    rdfs:label "someone else's claim is a fence" ;
    rdfs:comment "A claim held by another holder is refused, with the holder's name; pick another item and never work around a claim." ;
    harness:statedIn "AGENTS.md" ; harness:section "1. Claim the item before you write" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:toolCall ; harness:category harness:authoritySafety .

ctl:claim-held-by-another a harness:Control ;
    rdfs:label "claim: held by another holder" ;
    rdfs:comment "The ledger refuses a claim on an item another holder holds on a live lease; tools/gonk.py records the refusal it relays. Recognized by the ledger's wording (`already claimed by`), so a change of wording silences the firing and not the refusal: tests/test_integration.py asserts the wording against a real gonk." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:toolCall ; harness:category harness:authoritySafety ;
    harness:outcome harness:refuse ;
    harness:enforcedAt "ikigai-rs/ikigai-ledger:src/endpoints.rs" , "tools/gonk.py#fire_claim_refusal" ;
    harness:statedBy guide:a-claim-is-a-fence ;
    harness:firedBy test:test_harness:SensorsFire.test_claim_held_by_another .

ctl:claim-lease-expired a harness:Control ;
    rdfs:label "claim: an expired lease is not free" ;
    rdfs:comment "The ledger refuses a plain claim on an item whose holder's lease ran out, naming the takeover that would take it; tools/gonk.py records the refusal it relays." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:toolCall ; harness:category harness:authoritySafety ;
    harness:outcome harness:refuse ;
    harness:enforcedAt "ikigai-rs/ikigai-ledger:src/endpoints.rs" , "tools/gonk.py#fire_claim_refusal" ;
    harness:statedBy guide:expired-lease-not-free ;
    harness:firedBy test:test_harness:SensorsFire.test_claim_lease_expired .

ctl:takeover-refused a harness:Control ;
    rdfs:label "takeover: only an expired lease, from its holder" ;
    rdfs:comment "The ledger refuses a takeover of a lease that still runs, of a lease that never expires, of an item the named holder no longer holds, or of an unclaimed item; tools/gonk.py records the refusal it relays." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:toolCall ; harness:category harness:authoritySafety ;
    harness:outcome harness:refuse ;
    harness:enforcedAt "ikigai-rs/ikigai-ledger:src/endpoints.rs" , "tools/gonk.py#fire_claim_refusal" ;
    harness:statedBy guide:expired-lease-not-free ;
    harness:firedBy test:test_harness:SensorsFire.test_takeover_refused .

ctl:status-claim-check a harness:Control ;
    rdfs:label "status: does this tree hold a live claim?" ;
    rdfs:comment "`tools/gonk.py status` asks gonk whether this working tree's recorded claim is still its holder's, open, and on a lease with time left, and exits 1 when it is not. A report the agent asks for, not a firing." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:toolCall ; harness:category harness:authoritySafety ;
    harness:outcome harness:report ;
    harness:enforcedAt "tools/gonk.py#cmd_status" , "tools/gonk.py#check_claim" ;
    harness:statedBy guide:stop-when-claim-gone .

# ── one-agent (profiles/harness/one-agent.ttl)

guide:one-agent-per-tree a harness:Guide ;
    rdfs:label "one agent per item, one agent per working tree" ;
    rdfs:comment "An item has one holder at a time and a working tree one agent at a time; parallel agents each get a working tree and a holder name of their own, and a tree holds one claim." ;
    harness:statedIn "AGENTS.md" ; harness:section "2. One agent per claimed item, one agent per working tree" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:toolCall ; harness:category harness:authoritySafety .

ctl:one-claim-per-tree a harness:Control ;
    rdfs:label "a working tree holds one claim" ;
    rdfs:comment "`tools/gonk.py claim` refuses a second item while this working tree's claim file records another." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:toolCall ; harness:category harness:authoritySafety ;
    harness:outcome harness:refuse ;
    harness:enforcedAt "tools/gonk.py#cmd_claim" ;
    harness:statedBy guide:one-agent-per-tree ;
    harness:firedBy test:test_harness:SensorsFire.test_one_claim_per_tree .

# ── reproduce (profiles/harness/reproduce.ttl)

guide:reproduce-before-fix a harness:Guide ;
    rdfs:label "reproduce before you fix" ;
    rdfs:comment "A bug report, a finding or a measurement is a claim: reproduce it first, report it as not a defect with the evidence when it does not reproduce, and never change something only because the item expected a change." ;
    harness:statedIn "AGENTS.md" ; harness:section "3. Reproduce before you fix" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:toolCall ; harness:category harness:behavior .

# ── pull-requests (profiles/harness/pull-requests.ttl)

guide:green-ci-before-merge a harness:Guide ;
    rdfs:label "every change through a pull request with green CI" ;
    rdfs:comment "Work on a branch, open a pull request, and merge only when every CI check passed: never red, never while checks run." ;
    harness:statedIn "AGENTS.md" ; harness:section "4. Every change through a pull request with green CI" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:merge ; harness:category harness:behavior .

guide:gates-before-push a harness:Guide ;
    rdfs:label "run the checks before you push" ;
    rdfs:comment "Run the checks locally before pushing (`just gates`), and read their output." ;
    harness:statedIn "AGENTS.md" ; harness:section "4. Every change through a pull request with green CI" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:preCommit ; harness:category harness:behavior .

guide:last-command-exit-status a harness:Guide ;
    rdfs:label "a pipeline's status is its last command's" ;
    rdfs:comment "A command's exit status is the last command's in a pipeline: never pipe a command whose result you are trusting." ;
    harness:statedIn "AGENTS.md" ; harness:section "4. Every change through a pull request with green CI" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:toolCall ; harness:category harness:behavior .

guide:stage-files-by-name a harness:Guide ;
    rdfs:label "stage files by name" ;
    rdfs:comment "Stage the files you changed by name: `git add -A` picks up files that are not yours." ;
    harness:statedIn "AGENTS.md" ; harness:section "4. Every change through a pull request with green CI" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:preCommit ; harness:category harness:authoritySafety .

ctl:ci-checks a harness:Control ;
    rdfs:label "CI on every pull request" ;
    rdfs:comment "The repository's CI workflow runs its checks on every pull request and push to main. Its verdict is recorded by the CI service, not in this working tree's firing log. Whether a red pull request can still be merged is the hosting service's branch protection, which no file here sets." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:ci ; harness:category harness:behavior ;
    harness:outcome harness:refuse ;
    harness:enforcedAt ".github/workflows/ci.yml" ;
    harness:statedBy guide:green-ci-before-merge .

ctl:local-gates a harness:Control ;
    rdfs:label "the local gates" ;
    rdfs:comment "`just gates` runs the same checks as CI before a push. It records nothing in the firing log: its verdict is its exit status." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:preCommit ; harness:category harness:behavior , harness:maintainability ;
    harness:outcome harness:refuse ;
    harness:enforcedAt "justfile#gates" ;
    harness:statedBy guide:gates-before-push .

# ── report (profiles/harness/report.ttl)

guide:report-with-evidence a harness:Guide ;
    rdfs:label "report with evidence" ;
    rdfs:comment "Finished work is reported with the evidence that it is done, a pull request's URL or the reproduction that shows it is not a defect, recorded as a comment a later reader can check." ;
    harness:statedIn "AGENTS.md" ; harness:section "5. Report with evidence; the dispatcher closes" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:toolCall ; harness:category harness:behavior .

guide:dispatcher-closes-on-evidence a harness:Guide ;
    rdfs:label "the dispatcher closes, after checking the evidence" ;
    rdfs:comment "Only the dispatcher closes an item, and only after checking its evidence: the pull request merged, with green CI." ;
    harness:statedIn "AGENTS.md" ; harness:section "5. Report with evidence; the dispatcher closes" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:merge ; harness:category harness:authoritySafety , harness:behavior .

ctl:evidence-required a harness:Control ;
    rdfs:label "report and close need evidence" ;
    rdfs:comment "`tools/gonk.py report` and `close` refuse without `--evidence`, or with one that is not a URL, before anything reaches the ledger." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:toolCall ; harness:category harness:behavior ;
    harness:outcome harness:refuse ;
    harness:enforcedAt "tools/gonk.py#evidence_note" ;
    harness:statedBy guide:report-with-evidence ;
    harness:firedBy test:test_harness:SensorsFire.test_evidence_required .

ctl:reject-needs-reason a harness:Control ;
    rdfs:label "a rejection says why" ;
    rdfs:comment "`tools/gonk.py reject` refuses without a `--note`: a rejected hand-back with no reason leaves the next holder with nothing." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:merge ; harness:category harness:behavior ;
    harness:outcome harness:refuse ;
    harness:enforcedAt "tools/gonk.py#cmd_reject" ;
    harness:firedBy test:test_harness:SensorsFire.test_reject_needs_reason .

ctl:dispatcher-checks-evidence a harness:Control ;
    rdfs:label "the dispatcher checks the evidence" ;
    rdfs:comment "Before closing, the dispatcher (a person, or a hub agent) reads the evidence on the item: the pull request merged with green CI, or the reproduction holds. It closes, or rejects with the reason." ;
    harness:direction harness:feedback ; harness:execution harness:inferential ;
    harness:stage harness:merge ; harness:category harness:behavior , harness:authoritySafety ;
    harness:outcome harness:refuse ;
    harness:statedBy guide:dispatcher-closes-on-evidence .

# ── bare-numbers (profiles/harness/bare-numbers.ttl)

guide:no-bare-numbers a harness:Guide ;
    rdfs:label "never a bare #N" ;
    rdfs:comment "Ledger items and pull requests share numbers: write `<ledger>#N` or a link for an item, `PR #N` or `owner/repo#N` for a pull request, and `ledger item N` in a commit message." ;
    harness:statedIn "AGENTS.md" ; harness:section "6. Never a bare `#N`" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:toolCall ; harness:category harness:maintainability .

# ── accessibility (profiles/harness/accessibility.ttl)

guide:read-accessibility-first a harness:Guide ;
    rdfs:label "read ACCESSIBILITY.md before changing what people see" ;
    rdfs:comment "Before any change to a user interface or rendered output, read ACCESSIBILITY.md and keep its rules; record what was tested and with what, never claim testing that did not happen, and never weaken a check to make a change pass." ;
    harness:statedIn "AGENTS.md" ; harness:section "7. Read ACCESSIBILITY.md before changing what people see" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:toolCall ; harness:category harness:behavior .

# ── layout (profiles/harness/layout.ttl)

guide:artifacts-line-true a harness:Guide ;
    rdfs:label "keep the Artifacts line true" ;
    rdfs:comment "A spec or a change names the artifacts it touches on its `Artifacts:` line; keep it true when code is added or moved." ;
    harness:statedIn "AGENTS.md" ; harness:section "Specs, artifacts, queries and scripts" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:toolCall ; harness:category harness:architectureFitness .

guide:publish-through-init a harness:Guide ;
    rdfs:label "publish queries and scripts only through init" ;
    rdfs:comment "Saved queries and scripts are published to gonk by `tools/gonk.py init` when gonk offers `urn:script:`, and not any other way." ;
    harness:statedIn "AGENTS.md" ; harness:section "Specs, artifacts, queries and scripts" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:toolCall ; harness:category harness:architectureFitness .

ctl:init-report a harness:Control ;
    rdfs:label "init: what is missing" ;
    rdfs:comment "`tools/gonk.py init` checks the layout, every artifact a spec names, the saved scripts, the process's hooks and checks and how gonk answers, publishes the saved queries and scripts, and names what is missing. A report, not a firing." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:toolCall ; harness:category harness:architectureFitness ;
    harness:outcome harness:report ;
    harness:enforcedAt "tools/gonk.py#cmd_init" ;
    harness:statedBy guide:artifacts-line-true , guide:publish-through-init .

# ── spec-first (profiles/harness/spec-first.ttl)

guide:change-starts-as-a-folder a harness:Guide ;
    rdfs:label "a change in behavior starts as a change folder" ;
    rdfs:comment "A change in behavior is `openspec/changes/<id>/`, its proposal, deltas and tasks, written before the code; a fix that restores what a spec already says needs none." ;
    harness:statedIn "AGENTS.md" ; harness:section "Spec first" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:toolCall ; harness:category harness:behavior .

guide:take-what-next-offers a harness:Guide ;
    rdfs:label "take what next offers" ;
    rdfs:comment "Seed files a change's open tasks in order and the first is ready; working from `next` keeps a change's tasks in their written order." ;
    harness:statedIn "AGENTS.md" ; harness:section "Spec first" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:toolCall ; harness:category harness:behavior .

guide:keep-the-spec-true a harness:Guide ;
    rdfs:label "keep the spec true" ;
    rdfs:comment "When a change is finished its deltas become what `specs/` says and the change folder moves to `changes/archive/`, in the pull request of its last task." ;
    harness:statedIn "AGENTS.md" ; harness:section "Spec first" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:merge ; harness:category harness:maintainability .

ctl:seed-orders-tasks a harness:Control ;
    rdfs:label "seed: tasks in their written order" ;
    rdfs:comment "`tools/gonk.py seed` files each open task once, keyed by its IRI, and links each to the next with `blocks`, so the ledger's `next` offers a change's tasks in the order tasks.md lists them. A guide a program applies: it shapes what is offered rather than refusing anything." ;
    harness:direction harness:feedforward ; harness:execution harness:computational ;
    harness:stage harness:toolCall ; harness:category harness:behavior ;
    harness:enforcedAt "tools/gonk.py#cmd_seed" ;
    harness:statedBy guide:take-what-next-offers .

# ── workers (profiles/harness/workers.ttl)

guide:dispatcher-marks-the-work a harness:Guide ;
    rdfs:label "the dispatcher marks the work" ;
    rdfs:comment "A worker takes only items carrying every label its configuration names; an item without them is never taken by a worker." ;
    harness:statedIn "AGENTS.md" ; harness:section "Worker machines" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:runtime ; harness:category harness:authoritySafety .

guide:worker-never-closes-or-merges a harness:Guide ;
    rdfs:label "a worker never closes and never merges" ;
    rdfs:comment "A worker claims, works and reports, with the pull request and its CI as the evidence; the dispatcher checks it, then merges and closes, or rejects with the reason." ;
    harness:statedIn "AGENTS.md" ; harness:section "Worker machines" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:runtime ; harness:category harness:authoritySafety .

guide:one-agent-per-repository a harness:Guide ;
    rdfs:label "one agent per repository" ;
    rdfs:comment "A worker takes no item whose repository has a live claim held by anyone, and runs one item per repository on its machine." ;
    harness:statedIn "AGENTS.md" ; harness:section "Worker machines" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:runtime ; harness:category harness:authoritySafety .

ctl:worker-refuses-root a harness:Control ;
    rdfs:label "worker: never as root" ;
    rdfs:comment "`tools/worker.py run` refuses to start as root: a worker runs as an account of its own, which is its boundary (worker/README.md)." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:runtime ; harness:category harness:authoritySafety ;
    harness:outcome harness:refuse ;
    harness:wiredBy "worker-config" ;
    harness:enforcedAt "tools/worker.py#cmd_run" ;
    harness:firedBy test:test_harness:SensorsFire.test_worker_refuses_root .

ctl:worker-needs-labels a harness:Control ;
    rdfs:label "worker: labels name its work" ;
    rdfs:comment "The worker refuses a configuration that names no labels: one that takes every ready item in a ledger takes work nobody meant for it." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:runtime ; harness:category harness:authoritySafety ;
    harness:outcome harness:refuse ;
    harness:wiredBy "worker-config" ;
    harness:enforcedAt "tools/worker.py#load_worker" ;
    harness:statedBy guide:dispatcher-marks-the-work ;
    harness:firedBy test:test_harness:SensorsFire.test_worker_needs_labels .

ctl:worker-work-root-in-home a harness:Control ;
    rdfs:label "worker: works only in its own home" ;
    rdfs:comment "The worker refuses a work root that is not strictly under its own account's home: never a person's checkouts or a shared directory." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:runtime ; harness:category harness:authoritySafety ;
    harness:outcome harness:refuse ;
    harness:wiredBy "worker-config" ;
    harness:enforcedAt "tools/worker.py#work_root" ;
    harness:firedBy test:test_harness:SensorsFire.test_worker_work_root_in_home .

ctl:worker-skips-claimed a harness:Control ;
    rdfs:label "worker: skips a claimed item" ;
    rdfs:comment "The worker does not take an item someone holds a claim on. Recorded once per item per run of the loop, not at every poll." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:runtime ; harness:category harness:authoritySafety ;
    harness:outcome harness:refuse ;
    harness:wiredBy "worker-config" ;
    harness:enforcedAt "tools/worker.py#skip_reason" ;
    harness:statedBy guide:a-claim-is-a-fence ;
    harness:firedBy test:test_harness:SensorsFire.test_worker_skips_claimed .

ctl:worker-one-repository-label a harness:Control ;
    rdfs:label "worker: exactly one of its repositories" ;
    rdfs:comment "The worker does not take an item unless it carries exactly one `repo:<name>` label naming a repository its configuration lists." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:runtime ; harness:category harness:authoritySafety ;
    harness:outcome harness:refuse ;
    harness:wiredBy "worker-config" ;
    harness:enforcedAt "tools/worker.py#skip_reason" ;
    harness:statedBy guide:dispatcher-marks-the-work ;
    harness:firedBy test:test_harness:SensorsFire.test_worker_one_repository_label .

ctl:worker-skips-awaiting-dispatcher a harness:Control ;
    rdfs:label "worker: skips a hand-back awaiting its dispatcher" ;
    rdfs:comment "The worker does not take an item handed back and waiting for its dispatcher to check the evidence." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:runtime ; harness:category harness:authoritySafety ;
    harness:outcome harness:refuse ;
    harness:wiredBy "worker-config" ;
    harness:enforcedAt "tools/worker.py#skip_reason" ;
    harness:statedBy guide:dispatcher-closes-on-evidence ;
    harness:firedBy test:test_harness:SensorsFire.test_worker_skips_awaiting_dispatcher .

ctl:worker-skips-handed-back a harness:Control ;
    rdfs:label "worker: never the same item twice" ;
    rdfs:comment "The worker does not take an item it handed back before, until `worker.py forget` clears it." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:runtime ; harness:category harness:behavior ;
    harness:outcome harness:refuse ;
    harness:wiredBy "worker-config" ;
    harness:enforcedAt "tools/worker.py#skip_reason" ;
    harness:firedBy test:test_harness:SensorsFire.test_worker_skips_handed_back .

ctl:worker-one-agent-per-repository a harness:Control ;
    rdfs:label "worker: one agent per repository" ;
    rdfs:comment "The worker does not take an item whose repository has a live claim held by anyone, nor one whose repository has an item running on this machine, and backs off a claim it took when it then finds another. Best effort until the ledger enforces it: two workers can read free at one moment." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:runtime ; harness:category harness:authoritySafety ;
    harness:outcome harness:refuse ;
    harness:wiredBy "worker-config" ;
    harness:enforcedAt "tools/worker.py#skip_reason" , "tools/worker.py#run_once" , "tools/worker.py#work" ;
    harness:statedBy guide:one-agent-per-repository ;
    harness:firedBy test:test_harness:SensorsFire.test_worker_one_agent_per_repository .

ctl:worker-claim-lost a harness:Control ;
    rdfs:label "worker: stops when its claim is gone" ;
    rdfs:comment "The worker's heartbeat reads the item before each renewal; when the claim is someone else's, released or closed, or the renewal is refused, it stops the agent, says so on the item and releases nothing." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:runtime ; harness:category harness:authoritySafety ;
    harness:outcome harness:refuse ;
    harness:wiredBy "worker-config" ;
    harness:enforcedAt "tools/worker.py#work_claimed" ;
    harness:statedBy guide:stop-when-claim-gone ;
    harness:firedBy test:test_harness:SensorsFire.test_worker_claim_lost .

ctl:worker-budget-overrun a harness:Control ;
    rdfs:label "worker: the agent's budget" ;
    rdfs:comment "The worker stops an agent that runs past its wall-clock budget and hands the item back without evidence, keeping the worktree." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:runtime ; harness:category harness:behavior ;
    harness:outcome harness:refuse ;
    harness:wiredBy "worker-config" ;
    harness:enforcedAt "tools/worker.py#work_claimed" ;
    harness:firedBy test:test_harness:SensorsFire.test_worker_budget_overrun .

ctl:worker-no-evidence a harness:Control ;
    rdfs:label "worker: no hand-back without evidence" ;
    rdfs:comment "When the agent opened no pull request and reported no evidence, the worker releases the item with a note rather than handing it back as done." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:runtime ; harness:category harness:behavior ;
    harness:outcome harness:refuse ;
    harness:wiredBy "worker-config" ;
    harness:enforcedAt "tools/worker.py#work_claimed" ;
    harness:statedBy guide:report-with-evidence ;
    harness:firedBy test:test_harness:SensorsFire.test_worker_no_evidence .

ctl:worker-merged-before-exit a harness:Control ;
    rdfs:label "worker: a merge while the agent ran" ;
    rdfs:comment "The hand-back calls out a pull request the run opened that was merged before the agent exited: by the agent, against its rules, unless someone else merged it meanwhile. A warning: only branch protection can stop an agent merging." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:runtime ; harness:category harness:authoritySafety ;
    harness:outcome harness:warn ;
    harness:wiredBy "worker-config" ;
    harness:enforcedAt "tools/worker.py#work_claimed" ;
    harness:statedBy guide:worker-never-closes-or-merges ;
    harness:firedBy test:test_harness:SensorsFire.test_worker_merged_before_exit .

# ── claude-hook (profiles/harness/claude-hook.ttl)

ctl:edit-without-live-claim a harness:Control ;
    rdfs:label "claim hook: an edit needs a live claim" ;
    rdfs:comment "The optional Claude Code hook refuses a file edit unless this working tree holds a claim gonk still says is its holder's, on an open item, with time left on the lease. It cannot see a file written by a shell command." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:toolCall ; harness:category harness:authoritySafety ;
    harness:outcome harness:refuse ;
    harness:enforcedAt "hooks/claude/require-claim.py#decide" ;
    harness:wiredBy "claude:require-claim" ;
    harness:statedBy guide:claim-before-write , guide:stop-when-claim-gone ;
    harness:firedBy test:test_harness:SensorsFire.test_edit_without_live_claim .

ctl:edit-hook-not-wired a harness:Control ;
    rdfs:label "claim hook: no claim can be checked" ;
    rdfs:comment "The claim hook refuses a file edit in a repository that names no ledger, or does not say how to reach gonk, since no claim can be checked there." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:toolCall ; harness:category harness:authoritySafety ;
    harness:outcome harness:refuse ;
    harness:enforcedAt "hooks/claude/require-claim.py#decide" ;
    harness:wiredBy "claude:require-claim" ;
    harness:statedBy guide:claim-before-write ;
    harness:firedBy test:test_harness:SensorsFire.test_edit_hook_not_wired .

ctl:edit-hook-unreadable-input a harness:Control ;
    rdfs:label "claim hook: input it cannot read" ;
    rdfs:comment "The claim hook refuses when the tool call it is given is not JSON: it fails closed. The firing is recorded in the repository the hook runs in, when there is one." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:toolCall ; harness:category harness:authoritySafety ;
    harness:outcome harness:refuse ;
    harness:enforcedAt "hooks/claude/require-claim.py#main" ;
    harness:wiredBy "claude:require-claim" ;
    harness:statedBy guide:claim-before-write ;
    harness:firedBy test:test_harness:SensorsFire.test_edit_hook_unreadable_input .
