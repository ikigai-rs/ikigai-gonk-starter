guide:green-ci-before-merge a harness:Guide ;
    rdfs:label "every change through a pull request with green CI" ;
    rdfs:comment "Work on a branch, open a pull request, and merge only when every CI check passed: never red, never while checks run." ;
    harness:statedIn "AGENTS.md" ; harness:section "4. Every change through a pull request with green CI" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:merge ; harness:category harness:behavior .

guide:gates-before-push a harness:Guide ;
    rdfs:label "run the checks before you push" ;
    rdfs:comment "Run the checks locally before pushing (`just gates`), and read their output." ;
    harness:statedIn "AGENTS.md" ; harness:section "4. Every change through a pull request with green CI" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:preCommit ; harness:category harness:behavior .

guide:last-command-exit-status a harness:Guide ;
    rdfs:label "a pipeline's status is its last command's" ;
    rdfs:comment "A command's exit status is the last command's in a pipeline: never pipe a command whose result you are trusting." ;
    harness:statedIn "AGENTS.md" ; harness:section "4. Every change through a pull request with green CI" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:toolCall ; harness:category harness:behavior .

guide:stage-files-by-name a harness:Guide ;
    rdfs:label "stage files by name" ;
    rdfs:comment "Stage the files you changed by name: `git add -A` picks up files that are not yours." ;
    harness:statedIn "AGENTS.md" ; harness:section "4. Every change through a pull request with green CI" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:preCommit ; harness:category harness:authoritySafety .

ctl:ci-checks a harness:Control ;
    rdfs:label "CI on every pull request" ;
    rdfs:comment "The repository's CI workflow runs its checks on every pull request and push to main. Its verdict is recorded by the CI service, not in this working tree's firing log. Whether a red pull request can still be merged is the hosting service's branch protection, which no file here sets." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:ci ; harness:category harness:behavior ;
    harness:outcome harness:refuse ;
    harness:enforcedAt ".github/workflows/ci.yml" ;
    harness:statedBy guide:green-ci-before-merge .

ctl:local-gates a harness:Control ;
    rdfs:label "the local gates" ;
    rdfs:comment "`just gates` runs the same checks as CI before a push. It records nothing in the firing log: its verdict is its exit status." ;
    harness:direction harness:feedback ; harness:execution harness:computational ;
    harness:stage harness:preCommit ; harness:category harness:behavior , harness:maintainability ;
    harness:outcome harness:refuse ;
    harness:enforcedAt "justfile#gates" ;
    harness:statedBy guide:gates-before-push .
