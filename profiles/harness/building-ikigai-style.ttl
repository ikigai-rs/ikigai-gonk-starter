guide:building-ikigai-style a harness:Guide ;
    rdfs:label "building in the ikigai style (optional)" ;
    rdfs:comment "If you build in the ikigai style, consider `docs/resource-design.md` for resource-first design and `docs/ui-conventions.md` for views. Neither is required; a project that is not resource-oriented can ignore both. If you design resource-first, a `## Resource map` in the proposal or pull request can show the result. Whatever you build, `ACCESSIBILITY.md` stays the floor." ;
    harness:statedIn "AGENTS.md" ; harness:section "Building in the ikigai style (optional)" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:toolCall ; harness:category harness:architectureFitness .
