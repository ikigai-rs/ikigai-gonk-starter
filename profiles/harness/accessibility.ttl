guide:read-accessibility-first a harness:Guide ;
    rdfs:label "read ACCESSIBILITY.md before changing what people see" ;
    rdfs:comment "Before any change to a user interface or rendered output, read ACCESSIBILITY.md and keep its rules; record what was tested and with what, never claim testing that did not happen, and never weaken a check to make a change pass." ;
    harness:statedIn "AGENTS.md" ; harness:section "7. Read ACCESSIBILITY.md before changing what people see" ;
    harness:direction harness:feedforward ; harness:execution harness:inferential ;
    harness:stage harness:toolCall ; harness:category harness:behavior .
